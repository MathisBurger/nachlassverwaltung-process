<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_17gqaml" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_04n5tom">
    <bpmn:participant id="Participant_0xvzoah" name="Nachlassanlageprozess" processRef="estateRegistrationProzess" />
    <bpmn:participant id="Participant_18jmyqt" name="Erblasser" />
    <bpmn:messageFlow id="Flow_0rfvuqm" name="Dokumentenauswahlanfrage" sourceRef="Activity_0rdll59" targetRef="Participant_18jmyqt" />
    <bpmn:messageFlow id="Flow_0kz25bv" name="Dokumentenauswahl" sourceRef="Participant_18jmyqt" targetRef="Activity_0rdll59" />
  </bpmn:collaboration>
  <bpmn:process id="estateRegistrationProzess" name="Nachlassanlageprozess" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Der Nachlass muss angelegt werden">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">execution.setVariable("estateList", S(JSON.stringify([])));</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_110x42t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_1w9b210">
      <bpmn:incoming>Flow_110x42t</bpmn:incoming>
      <bpmn:outgoing>Flow_0orxbx6</bpmn:outgoing>
      <bpmn:outgoing>Flow_17am70l</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="Activity_0rdll59" name="Vorsorgedokumente anlegen">
      <bpmn:incoming>Flow_0orxbx6</bpmn:incoming>
      <bpmn:outgoing>Flow_0feepri</bpmn:outgoing>
      <bpmn:startEvent id="Event_0mgg4f4" name="Vorsorgedokumente müssen gepflegt werden">
        <bpmn:extensionElements>
          <camunda:executionListener event="end">
            <camunda:script scriptFormat="JavaScript">execution.setVariable("advanceDirectiveContents", S(JSON.stringify({})));

execution.setVariableLocal("selectedAdvanceDirectives", S("[]"));</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_0ou1j6c</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_0va1d63" name="Vorsorgedokumente erfolgreich hinterlegt">
        <bpmn:incoming>Flow_0asulu5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="Event_1e3zoix" name="Keine Dokumente hinterlegt">
        <bpmn:incoming>Flow_1oz0edi</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_0nyr33z" name="mindestens ein Dokument gewählt?" default="Flow_1oz0edi">
        <bpmn:incoming>Flow_1nhec1g</bpmn:incoming>
        <bpmn:outgoing>Flow_1oz0edi</bpmn:outgoing>
        <bpmn:outgoing>Flow_0lllva9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="Activity_193rmu7" name="Auswahl Dokumente anfragen" camunda:expression="${1}">
        <bpmn:extensionElements>
          <camunda:executionListener event="start">
            <camunda:script scriptFormat="JavaScript">print("Requesting selection of advancedDirectives (advanceDecisionToRefuseTreatment, powerOfAttorney, nominationOfGuardian) from " + execution.getProcessBusinessKey())</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0ou1j6c</bpmn:incoming>
        <bpmn:outgoing>Flow_1wcxwna</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="Activity_1e8jhen" name="Auswahl empfangen" messageRef="Message_0efs2mf">
        <bpmn:extensionElements>
          <camunda:executionListener event="end">
            <camunda:script scriptFormat="JavaScript">const list = [];
if (execution.getVariable("advanceDecisionToRefuseTreatment") ?? false) list.push("advanceDecisionToRefuseTreatment");
if (execution.getVariable("powerOfAttorney") ?? false) list.push("powerOfAttorney");
if (execution.getVariable("nominationOfGuardian") ?? false) list.push("nominationOfGuardian");

execution.setVariable("selectedAdvanceDirectives", S(JSON.stringify(list)));</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1wcxwna</bpmn:incoming>
        <bpmn:outgoing>Flow_1nhec1g</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:subProcess id="Activity_127njpj">
        <bpmn:incoming>Flow_0lllva9</bpmn:incoming>
        <bpmn:outgoing>Flow_0asulu5</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics camunda:collection="${selectedAdvanceDirectives.elements()}" camunda:elementVariable="documentIdRaw" />
        <bpmn:startEvent id="Event_1v1mkjz">
          <bpmn:extensionElements>
            <camunda:executionListener event="start">
              <camunda:script scriptFormat="JavaScript">execution.setVariableLocal("documentId", documentIdRaw.stringValue());
execution.setVariableLocal("documentContent", null);</camunda:script>
            </camunda:executionListener>
          </bpmn:extensionElements>
          <bpmn:outgoing>Flow_0ftxxot</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:endEvent id="Event_01jufgh">
          <bpmn:extensionElements>
            <camunda:executionListener event="end">
              <camunda:script scriptFormat="JavaScript">const advanceDirectiveContentsRaw = JSON.parse(advanceDirectiveContents.toString());
advanceDirectiveContentsRaw[documentId] = documentContent;

execution.setVariable("advanceDirectiveContents", S(JSON.stringify(advanceDirectiveContentsRaw)));</camunda:script>
            </camunda:executionListener>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1ri2gut</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:callActivity id="Activity_0s8h49w" name="Vorsorgedokument verarbeiten" calledElement="advanceDirectiveDocumentProcess">
          <bpmn:extensionElements>
            <camunda:in businessKey="#{execution.processBusinessKey}" />
            <camunda:in source="documentId" target="documentId" />
            <camunda:out source="documentContent" target="documentContent" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_0ftxxot</bpmn:incoming>
          <bpmn:outgoing>Flow_1ri2gut</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:sequenceFlow id="Flow_0ftxxot" sourceRef="Event_1v1mkjz" targetRef="Activity_0s8h49w" />
        <bpmn:sequenceFlow id="Flow_1ri2gut" sourceRef="Activity_0s8h49w" targetRef="Event_01jufgh" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_0ou1j6c" sourceRef="Event_0mgg4f4" targetRef="Activity_193rmu7" />
      <bpmn:sequenceFlow id="Flow_0asulu5" sourceRef="Activity_127njpj" targetRef="Event_0va1d63" />
      <bpmn:sequenceFlow id="Flow_1oz0edi" sourceRef="Gateway_0nyr33z" targetRef="Event_1e3zoix" />
      <bpmn:sequenceFlow id="Flow_1nhec1g" sourceRef="Activity_1e8jhen" targetRef="Gateway_0nyr33z" />
      <bpmn:sequenceFlow id="Flow_0lllva9" name="Ja" sourceRef="Gateway_0nyr33z" targetRef="Activity_127njpj">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${selectedAdvanceDirectives.elements().size() &gt; 0}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1wcxwna" sourceRef="Activity_193rmu7" targetRef="Activity_1e8jhen" />
    </bpmn:subProcess>
    <bpmn:callActivity id="Activity_17pu7b7" name="Letze Worte aufnehmen" calledElement="lastWordsProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in sourceExpression="${null}" target="preference" />
        <camunda:in sourceExpression="${null}" target="lastWords" />
        <camunda:out source="lastWords" target="lastWords" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17am70l</bpmn:incoming>
      <bpmn:outgoing>Flow_1jl03xz</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="Gateway_1fux41a">
