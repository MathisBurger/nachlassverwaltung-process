  <bpmn:collaboration id="Collaboration_04n5tom">
    <bpmn:participant id="Participant_0xvzoah" name="Nachlassanlageprozess" processRef="estateRegistrationProzess" />
    <bpmn:participant id="Participant_18jmyqt" name="Erblasser" />
    <bpmn:messageFlow id="Flow_0quh3f6" name="Erbender Anlagebestätitung" sourceRef="Activity_1xluz0f" targetRef="Participant_18jmyqt" />
    <bpmn:messageFlow id="Flow_0t127c5" name="Erbenergänzung" sourceRef="Participant_18jmyqt" targetRef="Activity_1xluz0f" />
    <bpmn:messageFlow id="Flow_08jrum3" name="Neuer Erbschaftsgegenstand" sourceRef="Participant_18jmyqt" targetRef="Activity_1xluz0f" />
  </bpmn:collaboration>
  <bpmn:process id="estateRegistrationProzess" name="Nachlassanlageprozess" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Der Nachlass muss angelegt werden">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">execution.setVariable("estateList", S(JSON.stringify([])));</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_0ndoprd" name="Nachlass erfolgreich angelegt">
      <bpmn:incoming>Flow_1fcagyj</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Activity_1xluz0f" name="Testament erstellen und beglaubigen">
      <bpmn:outgoing>Flow_1fcagyj</bpmn:outgoing>
      <bpmn:startEvent id="Event_19aajiv" name="Testament Erstellung notwendig">
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.setVariableLocal(&#34;desiredHeirData&#34;, S(&#34;{}&#34;))}" event="start" />
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_0pyypfc</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_0w17oox" name="Testament erfolgreich erstellt">
        <bpmn:incoming>Flow_18rr8ez</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="recreateLastWill" name="Testament erneut erstellen">
        <bpmn:outgoing>Flow_1tpsrn3</bpmn:outgoing>
        <bpmn:linkEventDefinition id="LinkEventDefinition_1oxxqdn" name="recreateLastWill" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gateway_1111kav">
        <bpmn:incoming>Flow_0pyypfc</bpmn:incoming>
        <bpmn:incoming>Flow_1tpsrn3</bpmn:incoming>
        <bpmn:outgoing>Flow_1fu699j</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_0pyypfc" sourceRef="Event_19aajiv" targetRef="Gateway_1111kav" />
      <bpmn:sequenceFlow id="Flow_1tpsrn3" sourceRef="recreateLastWill" targetRef="Gateway_1111kav" />
      <bpmn:sequenceFlow id="Flow_1fu699j" sourceRef="Gateway_1111kav" targetRef="Activity_1iz454v" />
      <bpmn:callActivity id="Activity_1iz454v" name="Testament erstellen" calledElement="lastWillCreationProcess">
        <bpmn:extensionElements>
          <camunda:in businessKey="#{execution.processBusinessKey}" />
          <camunda:in source="estateList" target="estateList" />
          <camunda:out source="signedLastWill" target="signedLastWill" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1fu699j</bpmn:incoming>
        <bpmn:outgoing>Flow_18rr8ez</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_18rr8ez" sourceRef="Activity_1iz454v" targetRef="Event_0w17oox" />
      <bpmn:intermediateThrowEvent id="Event_0iw4e6g" name="Testament erneut erstellen">
        <bpmn:incoming>Flow_1cujfjp</bpmn:incoming>
        <bpmn:linkEventDefinition id="LinkEventDefinition_0esw8vx" name="recreateLastWill" />
      </bpmn:intermediateThrowEvent>
      <bpmn:callActivity id="Activity_0e0sca8" name="Erbschaftsgegenstand erfassen" calledElement="estateCreationProcess">
        <bpmn:extensionElements>
          <camunda:in businessKey="#{execution.processBusinessKey}" />
          <camunda:in source="estateList" target="estateList" />
          <camunda:in source="estateDocument" target="estateDocument" />
          <camunda:out source="estateList" target="estateList" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0hduc8w</bpmn:incoming>
        <bpmn:outgoing>Flow_06juoml</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_0hduc8w" sourceRef="Event_1045693" targetRef="Activity_0e0sca8" />
      <bpmn:boundaryEvent id="Event_1045693" name="Neuer Erbschaftsgegenstand erhalten" attachedToRef="Activity_1iz454v">
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.setVariableLocal(&#34;estateDocument&#34;, estateDocument)}" event="end" />
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_0hduc8w</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1ddz15q" messageRef="Message_3qnnv9q" />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Event_0kccbj9" name="Erbenergänzung erhalten" attachedToRef="Activity_1iz454v">
        <bpmn:extensionElements>
          <camunda:executionListener event="end">
            <camunda:script scriptFormat="JavaScript">const data = {firstName, lastName, email, birthday, idCardNumber};

execution.setVariable("desiredHeirData", S(JSON.stringify(data)));</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_0c5j8j5</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1l4teyr" messageRef="Message_2st5hgo" />
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="Activity_0k85c20" name="Bestätigung senden" camunda:expression="${1}">
        <bpmn:extensionElements>
          <camunda:executionListener event="start">
            <camunda:script scriptFormat="JavaScript">print("Sending additional heir added confirmation to " + execution.getProcessBusinessKey())</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1clffq4</bpmn:incoming>
        <bpmn:outgoing>Flow_0wf9837</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:callActivity id="Activity_1eyrfwi" name="Erbenden anlegen" calledElement="heirCreationProcess">
        <bpmn:extensionElements>
          <camunda:in source="heirsList" target="heirsList" />
          <camunda:in source="desiredHeirData" target="desiredHeirData" />
          <camunda:in businessKey="#{execution.processBusinessKey}" />
          <camunda:out source="heirsList" target="heirsList" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0c5j8j5</bpmn:incoming>
        <bpmn:outgoing>Flow_1clffq4</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_1clffq4" sourceRef="Activity_1eyrfwi" targetRef="Activity_0k85c20" />
      <bpmn:sequenceFlow id="Flow_0c5j8j5" sourceRef="Event_0kccbj9" targetRef="Activity_1eyrfwi" />
      <bpmn:exclusiveGateway id="Gateway_19pxe80">
