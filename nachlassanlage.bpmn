          <bpmn:extensionElements>
            <camunda:executionListener event="end">
              <camunda:script scriptFormat="JavaScript">const list = [];
if (advanceDecisionToRefuseTreatment) list.push("advanceDecisionToRefuseTreatment");
if (powerOfAttorney) list.push("powerOfAttorney");
if (nominationOfGuardian) list.push("nominationOfGuardian");

execution.setVariable("selectedAdvanceDirectives", S(JSON.stringify(list)));</camunda:script>
            </camunda:executionListener>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_1wcxwna</bpmn:incoming>
          <bpmn:outgoing>Flow_1nhec1g</bpmn:outgoing>
