    <bpmn:sequenceFlow id="Flow_110x42t" sourceRef="StartEvent_1" targetRef="Gateway_1w9b210" />
    <bpmn:endEvent id="Event_0bwm6br">
      <bpmn:incoming>Flow_0nuygj4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
