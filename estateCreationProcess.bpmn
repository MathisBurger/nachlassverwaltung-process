    <bpmn:userTask id="Activity_0hqc3es" name="Dokument prüfen" camunda:formRef="validateEstateDocumentForm" camunda:formRefBinding="latest" camunda:assignee="demo">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_09is580</bpmn:incoming>
      <bpmn:outgoing>Flow_06njirw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_154umow" name="Zugriffsinformationen notwendig?" default="Flow_1ufj2yl">
      <bpmn:incoming>Flow_0fu8d44</bpmn:incoming>
      <bpmn:outgoing>Flow_0a13uze</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ufj2yl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_0091fhj" name="Erbschafts-gegenstand anlegen" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_1hkj2b9</bpmn:incoming>
      <bpmn:outgoing>Flow_0y5nat4</bpmn:outgoing>
      <bpmn:script>const estateListRaw = JSON.parse(estateList.toString());

const estate = {title, estateDocument, accessInformation};
estateListRaw.push(estate);

execution.setVariable("estateList", S(JSON.stringify(estateListRaw)));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_1jk9khb">
      <bpmn:incoming>Flow_0cawuxp</bpmn:incoming>
      <bpmn:incoming>Flow_1ufj2yl</bpmn:incoming>
      <bpmn:outgoing>Flow_1hkj2b9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_118orjh" name="Zugriffsinformationen anfragen" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Requesting access information for estate with content " + estateDocument + " from " + execution.getProcessBusinessKey())</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0a13uze</bpmn:incoming>
      <bpmn:outgoing>Flow_0nn9qmd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_1869ygx" name="Zugriffsinformationen empfangen" messageRef="Message_0gnc8rv">
      <bpmn:incoming>Flow_0nn9qmd</bpmn:incoming>
      <bpmn:outgoing>Flow_0cawuxp</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_0cw2e7h" name="Dokument valide?">
      <bpmn:incoming>Flow_06njirw</bpmn:incoming>
      <bpmn:outgoing>Flow_0fu8d44</bpmn:outgoing>
      <bpmn:outgoing>Flow_0h9h1jj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0xli25u" name="Erbschaftsgegenstand angelegt">
      <bpmn:incoming>Flow_09hyad5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_0m4m26y" name="Bestätigung senden" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending successfully created estate confirmation to " + execution.getProcessBusinessKey())</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0y5nat4</bpmn:incoming>
      <bpmn:outgoing>Flow_09hyad5</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
