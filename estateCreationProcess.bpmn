  </bpmn:collaboration>
  <bpmn:process id="estateCreationProcess" name="Erbschaftsgegenstandsergänzung" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_197w1sr">
      <bpmn:lane id="Lane_0onnnql" name="Verwalter">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
