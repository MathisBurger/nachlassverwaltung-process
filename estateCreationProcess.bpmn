      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Erbschafts-gegenstand soll erfasst werden">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">execution.setVariable("accessInformation", null);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1ytp4go</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0a13uze" name="Ja" sourceRef="Gateway_154umow" targetRef="Activity_118orjh">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isAccessInformationRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0nn9qmd" sourceRef="Activity_118orjh" targetRef="Activity_1869ygx" />
