    <bpmn:sequenceFlow id="Flow_0fu8d44" name="Ja" sourceRef="Gateway_0cw2e7h" targetRef="Gateway_154umow">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isDocuentValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0h9h1jj" name="Nein" sourceRef="Gateway_0cw2e7h" targetRef="Gateway_1bs65wg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isDocuentValid == false}</bpmn:conditionExpression>
