    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_0pi1wj9" name="Behörden Informieren" camunda:expression="${print(&#34;Reporting fraud for ID card&#34; + initialRegistrationInformation.prop(&#34;idCardNumber&#34;).stringValue())}">
