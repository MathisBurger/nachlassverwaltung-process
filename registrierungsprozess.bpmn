    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_1r49j42" name="Identitätsprüfung anfragen" camunda:expression="${print(&#34;Requesting identify check for ID card &#34; + initialRegistrationInformation.prop(&#34;idCardNumber&#34;).stringValue())}">
      <bpmn:incoming>Flow_1lugzyi</bpmn:incoming>
      <bpmn:outgoing>Flow_1tttzoc</bpmn:outgoing>
