        <inputExpression id="InputExpression_0003" typeRef="integer">
          <text></text>
        </inputExpression>
      </input>
      <output id="OutputClause_0004" label="Servicepaket" typeRef="string" biodi:width="192">
        <outputValues id="UnaryTests_06fiz6g">
          <text></text>
        </outputValues>
      </output>
      <rule id="DecisionRule_0005">
        <inputEntry id="UnaryTests_0006">
          <text>&lt;= 2500</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0007">
          <text>"basic"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0008">
        <inputEntry id="UnaryTests_0009">
          <text>[2501..5000]</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0010">
          <text>"standard"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0011">
        <inputEntry id="UnaryTests_0012">
          <text>[5001..8000]</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0013">
          <text>"comfort"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0014">
        <inputEntry id="UnaryTests_0015">
          <text>&gt;=10000</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0016">
          <text>"premium"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="planCeremony" name="Trauerfeier planen" camunda:historyTimeToLive="180">
    <informationRequirement id="InformationRequirement_0017">
      <requiredInput href="#maxAmountGuests" />
    </informationRequirement>
    <decisionTable id="DecisionTable_Ceremony">
