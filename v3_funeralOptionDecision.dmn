        <inputEntry id="UnaryTests_0025">
          <text>0</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0026">
          <text>"silent"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0030">
        <inputEntry id="UnaryTests_0031">
          <text>[1..15]</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0032">
          <text>"small"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0036">
        <inputEntry id="UnaryTests_0037">
          <text>]15..50]</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0038">
          <text>"medium"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0042">
        <inputEntry id="UnaryTests_0043">
          <text>&gt;50</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0044">
          <text>"large"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
