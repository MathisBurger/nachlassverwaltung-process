  </bpmn:collaboration>
  <bpmn:process id="heirCreationProcess" name="Erbender Anlageprozess" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_0hkb6sj" />
    <bpmn:sequenceFlow id="Flow_0o9pxop" name="Valide" sourceRef="Gateway_1hut2rj" targetRef="Activity_0as00t3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${citizenIsValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0c1gv7k" name="Invalide" sourceRef="Gateway_1hut2rj" targetRef="Activity_0hxtjk5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!citizenIsValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19l9lfw" sourceRef="Activity_150s4uh" targetRef="Gateway_1jow6b9" />
    <bpmn:sequenceFlow id="Flow_1k4yo4t" name="Ja" sourceRef="Gateway_1jow6b9" targetRef="Activity_0mb13i2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${heirAlreadyExists}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18pfc0t" sourceRef="Activity_0ug0am1" targetRef="Activity_1u5vtu2" />
    <bpmn:sequenceFlow id="Flow_018y7jw" name="Nein" sourceRef="Gateway_1jow6b9" targetRef="Activity_0ug0am1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!heirAlreadyExists}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_00vgr4f" sourceRef="Activity_1u5vtu2" targetRef="Gateway_1hut2rj" />
    <bpmn:startEvent id="Event_1g5wjvw">
      <bpmn:outgoing>Flow_0uyr9nl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0uyr9nl" sourceRef="Event_1g5wjvw" targetRef="Activity_150s4uh" />
    <bpmn:scriptTask id="Activity_150s4uh" name="Prüfen ob Erbender bereits hinterlegt" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0uyr9nl</bpmn:incoming>
      <bpmn:outgoing>Flow_19l9lfw</bpmn:outgoing>
      <bpmn:property id="Property_1oz5nwz" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1ftpzf4">
        <bpmn:sourceRef>DataStoreReference_1rvsvb6</bpmn:sourceRef>
        <bpmn:targetRef>Property_1oz5nwz</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:script>const heirsListRaw = JSON.parse(heirsList.toString());

let exists = false;
for (const heir of heirsListRaw) {
if (desiredHeirData.prop("idCardNumber").stringValue() === heir.idCardNumber) {
exists = true;
break;
}
}

execution.setVariable("heirAlreadyExists", exists);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_1jow6b9" name="Bereits angelegt?">
      <bpmn:incoming>Flow_19l9lfw</bpmn:incoming>
      <bpmn:outgoing>Flow_1k4yo4t</bpmn:outgoing>
      <bpmn:outgoing>Flow_018y7jw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_0ug0am1" name="Personendaten senden" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending personal data " + desiredHeirData.toString() + " to local registration office");</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_018y7jw</bpmn:incoming>
      <bpmn:outgoing>Flow_18pfc0t</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_1u5vtu2" name="Prüfstatus empfangen" messageRef="Message_3j15d54">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariableLocal(&#34;idCardNumber&#34;, desiredHeirData.prop(&#34;idCardNumber&#34;).stringValue())}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18pfc0t</bpmn:incoming>
      <bpmn:outgoing>Flow_00vgr4f</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_1hut2rj" name="Welcher Status?">
      <bpmn:incoming>Flow_00vgr4f</bpmn:incoming>
      <bpmn:outgoing>Flow_0o9pxop</bpmn:outgoing>
      <bpmn:outgoing>Flow_0c1gv7k</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_0hxtjk5" name="Invaliditätsnachricht senden" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending invalidity notification about heir " + desiredHeirData.toString() + " to " + execution.getProcessBusinessKey())</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0c1gv7k</bpmn:incoming>
      <bpmn:outgoing>Flow_14fhio6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:scriptTask id="Activity_0as00t3" name="Erben anlegen" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0o9pxop</bpmn:incoming>
      <bpmn:outgoing>Flow_19hnutd</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_15q0rea">
        <bpmn:targetRef>DataStoreReference_1rvsvb6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script>var rawList = JSON.parse(heirsList.toString());
rawList.push(JSON.parse(desiredHeirData.toString()));

execution.setVariable("heirsList", S(JSON.stringify(rawList)));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:dataStoreReference id="DataStoreReference_1rvsvb6" name="Erben Datanbank">
      <bpmn:extensionElements />
    </bpmn:dataStoreReference>
    <bpmn:sendTask id="Activity_0mb13i2" name="Duplikatsnachricht senden" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending heir duplicate message for heir " + desiredHeirData.prop("idCardNumber").stringValue() + " to " + execution.getProcessBusinessKey())</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1k4yo4t</bpmn:incoming>
      <bpmn:outgoing>Flow_095qocf</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_14fhio6" sourceRef="Activity_0hxtjk5" targetRef="Event_1u6umsl" />
    <bpmn:endEvent id="Event_1u6umsl" name="Kein valider Bürger">
      <bpmn:incoming>Flow_14fhio6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_095qocf" sourceRef="Activity_0mb13i2" targetRef="Event_0ufi6un" />
    <bpmn:endEvent id="Event_0ufi6un" name="Erbe existiert bereits">
      <bpmn:incoming>Flow_095qocf</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_19hnutd" sourceRef="Activity_0as00t3" targetRef="Activity_0a4glnp" />
    <bpmn:endEvent id="Event_1e7foli" name="Erbe erfolgreich angelegt">
      <bpmn:incoming>Flow_1ncxv1b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1ncxv1b" sourceRef="Activity_0a4glnp" targetRef="Event_1e7foli" />
    <bpmn:sendTask id="Activity_0a4glnp" name="Bestätigung senden" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending successfully created heir confirmation to " + execution.getProcessBusinessKey());</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19hnutd</bpmn:incoming>
      <bpmn:outgoing>Flow_1ncxv1b</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
