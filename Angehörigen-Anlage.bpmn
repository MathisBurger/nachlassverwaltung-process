      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending invalidity notification about relative " + desiredRelativeData.toString() + " to " + execution.getProcessBusinessKey())</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0c1gv7k</bpmn:incoming>
      <bpmn:outgoing>Flow_0zk0r2o</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_1hut2rj" name="Welcher Status?">
