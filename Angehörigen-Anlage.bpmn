    <bpmn:sequenceFlow id="Flow_18nbofj" name="Ja" sourceRef="Gateway_0o7opkm" targetRef="Event_01woafc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${createNewRelative}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0c1gv7k" name="Invalide" sourceRef="Gateway_1hut2rj" targetRef="Activity_0hxtjk5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!citizenIsValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0zk0r2o" sourceRef="Activity_0hxtjk5" targetRef="Event_0q7t19r" />
    <bpmn:scriptTask id="Activity_150s4uh" name="Prüfen ob Erbanwärter bereits hinterlegt" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_1xdpxh7</bpmn:incoming>
      <bpmn:outgoing>Flow_19l9lfw</bpmn:outgoing>
      <bpmn:property id="Property_1oz5nwz" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1ftpzf4">
        <bpmn:sourceRef>DataStoreReference_1rvsvb6</bpmn:sourceRef>
        <bpmn:targetRef>Property_1oz5nwz</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:script>const relativesListRaw = JSON.parse(relativesList.toString());

let exists = false;
for (const relative of relativesListRaw) {
if (desiredRelativeData.prop("idCardNumber").stringValue() === relative.idCardNumber) {
exists = true;
break;
}
}

execution.setVariable("relativeAlreadyExists", exists);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_1jow6b9" name="Bereits angelegt?">
      <bpmn:incoming>Flow_19l9lfw</bpmn:incoming>
      <bpmn:outgoing>Flow_1k4yo4t</bpmn:outgoing>
      <bpmn:outgoing>Flow_018y7jw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_19l9lfw" sourceRef="Activity_150s4uh" targetRef="Gateway_1jow6b9" />
    <bpmn:sequenceFlow id="Flow_1k4yo4t" name="Ja" sourceRef="Gateway_1jow6b9" targetRef="Activity_0mb13i2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${relativeAlreadyExists}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="Activity_0mb13i2" name="Duplikatsnachricht senden" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending relative duplicate message for relative " + desiredRelativeData.prop("idCardNumber").stringValue() + " to " + execution.getProcessBusinessKey())</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1k4yo4t</bpmn:incoming>
      <bpmn:outgoing>Flow_05p4wqe</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_05p4wqe" sourceRef="Activity_0mb13i2" targetRef="Event_0nby4e3" />
    <bpmn:sequenceFlow id="Flow_18pfc0t" sourceRef="Activity_0ug0am1" targetRef="Activity_1u5vtu2" />
    <bpmn:sequenceFlow id="Flow_018y7jw" name="Nein" sourceRef="Gateway_1jow6b9" targetRef="Activity_0ug0am1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!relativeAlreadyExists}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="Activity_0ug0am1" name="Personendaten senden" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending personal data " + desiredRelativeData.toString() + " to local registration office");</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_018y7jw</bpmn:incoming>
      <bpmn:outgoing>Flow_18pfc0t</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_00vgr4f" sourceRef="Activity_1u5vtu2" targetRef="Gateway_1hut2rj" />
    <bpmn:endEvent id="Event_01woafc" name="Angehöriger angelegt mit weiterem folgend">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">execution.setVariableLocal("continueNew", true);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18nbofj</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_0yo1up4" name="Angehöriger angelegt ohne weiteren">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">execution.setVariableLocal("continueNew", false);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1inezak</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0o7opkm" name="Neuen Angehörigen anlegen?" default="Flow_1inezak">
      <bpmn:incoming>Flow_0fj5hij</bpmn:incoming>
      <bpmn:outgoing>Flow_1inezak</bpmn:outgoing>
      <bpmn:outgoing>Flow_18nbofj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_0as00t3" name="Erben anlegen" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0o9pxop</bpmn:incoming>
      <bpmn:outgoing>Flow_1vvuyyt</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_15q0rea">
        <bpmn:targetRef>DataStoreReference_1rvsvb6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script>var rawList = JSON.parse(relativesList.toString());
rawList.push(JSON.parse(desiredRelativeData.toString()));

execution.setVariable("relativesList", S(JSON.stringify(rawList)));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:receiveTask id="Activity_0mgg2to" name="Nächste Aktion empfangen" messageRef="Message_22p0qs1">
      <bpmn:incoming>Flow_0rdajio</bpmn:incoming>
      <bpmn:outgoing>Flow_0fj5hij</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Activity_10dwtqx" name="Nächste Aktion anfragen" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Requesting next action for relative creation from " + execution.getProcessBusinessKey());</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1vvuyyt</bpmn:incoming>
      <bpmn:outgoing>Flow_0rdajio</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_0q7t19r" name="Personendaten invalide">
      <bpmn:incoming>Flow_0zk0r2o</bpmn:incoming>
