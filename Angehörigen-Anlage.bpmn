      <bpmn:incoming>Flow_18pfc0t</bpmn:incoming>
      <bpmn:outgoing>Flow_00vgr4f</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_0nby4e3" name="Erbanwärter bereits angelegt">
      <bpmn:incoming>Flow_05p4wqe</bpmn:incoming>
    </bpmn:endEvent>
