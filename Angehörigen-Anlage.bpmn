  <bpmn:process id="relativeCreationProcess" name="Angehörigen Anlageprozess" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_0hkb6sj" />
    <bpmn:startEvent id="Event_1g5wjvw">
      <bpmn:outgoing>Flow_1yeipv5</bpmn:outgoing>
