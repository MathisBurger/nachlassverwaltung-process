    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_1c65hib" name="Erbanwärter-Anlage eingegangen">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">execution.setVariable("desiredRelativeData", S(JSON.stringify({firstName, lastName, email, birthday, idCardNumber})));</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0r9vxbz</bpmn:incoming>
      <bpmn:outgoing>Flow_08tjf6u</bpmn:outgoing>
