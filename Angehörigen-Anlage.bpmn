      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${desiredRelativeData != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08tjf6u" sourceRef="Event_1c65hib" targetRef="Gateway_1n4eedv" />
