      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${citizenIsValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1vvuyyt" sourceRef="Activity_0as00t3" targetRef="Activity_10dwtqx" />
    <bpmn:sequenceFlow id="Flow_0rdajio" sourceRef="Activity_10dwtqx" targetRef="Activity_0mgg2to" />
