            <camunda:script scriptFormat="JavaScript">print("Sending advancedDirectives changed confirmation to " + execution.getProcessBusinessKey())</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0ld124p</bpmn:incoming>
        <bpmn:outgoing>Flow_1xccn2q</bpmn:outgoing>
