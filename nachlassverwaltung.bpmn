      <bpmn:endEvent id="Event_0n8waag">
        <bpmn:extensionElements>
          <camunda:executionListener event="end">
            <camunda:script scriptFormat="JavaScript">let advanceDirectiveContentsRaw ={};

if (execution.hasVariable("advanceDirectiveContents")) {
advanceDirectiveContentsRaw = JSON.parse(advanceDirectiveContents.toString());
}

advanceDirectiveContentsRaw[documentIdLocal] =documentContent;
execution.setVariable("advanceDirectiveContents", S(JSON.stringify(advanceDirectiveContentsRaw)));</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1xccn2q</bpmn:incoming>
      </bpmn:endEvent>
