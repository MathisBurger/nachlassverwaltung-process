    <bpmn:callActivity id="Activity_1x1aepy" name="Nachlass anlegen" calledElement="estateRegistrationProzess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="heirsList" target="heirsList" />
        <camunda:out source="advanceDirectiveContents" target="advanceDirectiveContentsLocal" />
        <camunda:out source="estateList" target="estateList" />
        <camunda:out source="signedLastWill" target="signedLastWill" />
        <camunda:out source="lastWords" target="lastWordsLocal" />
        <camunda:out source="heirsList" target="heirsList" />
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">execution.setVariableLocal("advanceDirectiveContentsLocal",S("{}"));
execution.setVariableLocal("lastWordsLocal","");</camunda:script>
        </camunda:executionListener>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">const advanceDirectiveContentsRaw = {
  ...JSON.parse(advanceDirectiveContentsLocal.toString()),
  ...(execution.hasVariable("advanceDirectiveContents")
    ? JSON.parse(advanceDirectiveContents.toString())
    : {})
};

execution.setVariable("advanceDirectiveContents", S(JSON.stringify(advanceDirectiveContentsRaw)));

if (!execution.hasVariable("lastWords")) {
execution.setVariable("lastWords", lastWordsLocal);
}</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12j0i5v</bpmn:incoming>
      <bpmn:outgoing>Flow_1ax10xa</bpmn:outgoing>
