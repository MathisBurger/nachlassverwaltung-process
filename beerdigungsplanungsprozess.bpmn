    <bpmn:sequenceFlow id="Flow_0i2ybvh" name="Nein" sourceRef="Gateway_0x41rwn" targetRef="Activity_Feier">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${funeralOrder == null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ycqyhw" name="Ja" sourceRef="Gateway_0x41rwn" targetRef="Activity_0ooshf6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${funeralOrder != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_025f80p" sourceRef="Activity_0ooshf6" targetRef="Event_0vhxvz3" />
    <bpmn:sendTask id="Activity_Feier" name="Bestattungsinstitut beauftragen" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending funeral order to undertaker: " + funeralDecision.toString());</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0i2ybvh</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Activity_0ooshf6" name="Bestattungsauftrag ändern" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Sending updated funeral order to undertaker: " + funeralDecision.toString());</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ycqyhw</bpmn:incoming>
      <bpmn:outgoing>Flow_025f80p</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Fertig" name="Bestattung vollständig geplant">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
