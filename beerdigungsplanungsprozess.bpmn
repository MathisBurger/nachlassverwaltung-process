      <bpmn:outgoing>Flow_17zo3ui</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">10000000</bpmn:loopCardinality>
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${funeralAccepted}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Event_0ig7wes">
        <bpmn:extensionElements>
          <camunda:executionListener event="start">
            <camunda:script scriptFormat="JavaScript">execution.setVariableLocal("funeralType", funeralPreference.prop("funeralType").stringValue());
execution.setVariableLocal("funeralObject", funeralPreference.prop("funeralObject").stringValue());
execution.setVariableLocal("maxAmountGuests", funeralPreference.prop("maxAmountGuests").numberValue());
execution.setVariableLocal("budget", funeralPreference.prop("budget").numberValue());</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_13jktrk</bpmn:outgoing>
      </bpmn:startEvent>
