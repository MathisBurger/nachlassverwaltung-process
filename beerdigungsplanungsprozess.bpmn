    <bpmn:messageFlow id="Flow_0116he3" name="Bestattungspräfeenzen" sourceRef="Participant_11qf0vh" targetRef="Activity_1ciygxm" />
    <bpmn:messageFlow id="Flow_1wpgwup" name="Änderungswunsch" sourceRef="Participant_11qf0vh" targetRef="Event_19c9atk" />
    <bpmn:messageFlow id="Flow_1g6ap3l" name="Bestätigung" sourceRef="Participant_11qf0vh" targetRef="Event_07j6aif" />
    <bpmn:messageFlow id="Flow_0wp1dnd" name="Auftragsänderung" sourceRef="Activity_0ooshf6" targetRef="Participant_09uh32h" />
  </bpmn:collaboration>
  <bpmn:process id="funeralPlanningProcess" name="Bestattungsplanungsprozess" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_Trauerfall" name="Beerdigung soll geplant werden">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_0tqufez</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0cgx0e2" sourceRef="Activity_0dcyj4j" targetRef="Activity_1ciygxm" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Feier" targetRef="EndEvent_Fertig" />
    <bpmn:receiveTask id="Activity_1ciygxm" name="Bestattungspräferenzen empfangen" messageRef="Message_1vjje9l">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">const funeralPreference = S(JSON.stringify({funeralType, maxAmountGuests, budget}), "application/json");

execution.setVariable("funeralPreference", funeralPreference);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cgx0e2</bpmn:incoming>
      <bpmn:outgoing>Flow_1tdnw2y</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Activity_0dcyj4j" name="Bestattungspräferenzen anfragen" camunda:expression="${1}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">print("Requesting funeral preferences from " + execution.getProcessBusinessKey())</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0n20skx</bpmn:incoming>
      <bpmn:outgoing>Flow_0cgx0e2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_0eoijma" name="Präferenz schon bekannt?">
      <bpmn:incoming>Flow_0tqufez</bpmn:incoming>
      <bpmn:outgoing>Flow_0n20skx</bpmn:outgoing>
      <bpmn:outgoing>Flow_1em2fq1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0tqufez" sourceRef="StartEvent_Trauerfall" targetRef="Gateway_0eoijma" />
    <bpmn:sequenceFlow id="Flow_0n20skx" name="Nein" sourceRef="Gateway_0eoijma" targetRef="Activity_0dcyj4j">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${funeralPreference == null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:subProcess id="Activity_02rauh0" name="Bestattungsauftragerstellung">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="funeralType">${funeralPreference.prop("funeralType").stringValue()}</camunda:inputParameter>
          <camunda:inputParameter name="maxAmountGuests">${funeralPreference.prop("maxAmountGuests").numberValue()}</camunda:inputParameter>
          <camunda:inputParameter name="budget">${funeralPreference.prop("budget").numberValue()}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qcmghw</bpmn:incoming>
      <bpmn:outgoing>Flow_17zo3ui</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">10000000</bpmn:loopCardinality>
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${funeralAccepted}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Event_0ig7wes">
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.setVariableLocal(&#34;finalFuneralDecisionResult&#34;, null)}" event="start" />
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_13jktrk</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="Activity_0tzjd5f" name="Bestattungsoption entscheiden" camunda:resultVariable="finalFuneralDecisionResult" camunda:decisionRef="finalFuneralDecision" camunda:mapDecisionResult="singleResult">
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.setVariable(&#34;funeralDecision&#34;, JSON(finalFuneralDecisionResult))}" event="end" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_13jktrk</bpmn:incoming>
        <bpmn:outgoing>Flow_053h3mg</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:sequenceFlow id="Flow_053h3mg" sourceRef="Activity_0tzjd5f" targetRef="Activity_1uepr93" />
      <bpmn:sendTask id="Activity_1uepr93" name="Entscheidung senden" camunda:expression="${1}">
        <bpmn:extensionElements>
          <camunda:executionListener event="start">
            <camunda:script scriptFormat="JavaScript">print("Sending funeral decision: " + funeralDecision.toString());</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_053h3mg</bpmn:incoming>
        <bpmn:outgoing>Flow_03kzg1f</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_13jktrk" sourceRef="Event_0ig7wes" targetRef="Activity_0tzjd5f" />
      <bpmn:sequenceFlow id="Flow_03kzg1f" sourceRef="Activity_1uepr93" targetRef="Gateway_0timu5e" />
      <bpmn:eventBasedGateway id="Gateway_0timu5e">
        <bpmn:incoming>Flow_03kzg1f</bpmn:incoming>
        <bpmn:outgoing>Flow_1va1h17</bpmn:outgoing>
        <bpmn:outgoing>Flow_0uhi1kx</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="Event_19c9atk" name="Änderungswunsch empfangen">
        <bpmn:extensionElements>
          <camunda:executionListener event="end">
            <camunda:script scriptFormat="JavaScript">const funeralPreference = S(JSON.stringify({funeralType, maxAmountGuests, budget}), "application/json");

print(execution.getVariables().toString());

execution.setVariable("funeralPreference", funeralPreference);</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1va1h17</bpmn:incoming>
        <bpmn:outgoing>Flow_1jkx75d</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_18ahjp7" messageRef="Message_3viufsu" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_1va1h17" sourceRef="Gateway_0timu5e" targetRef="Event_19c9atk" />
      <bpmn:intermediateCatchEvent id="Event_07j6aif" name="Bestätigung empfangen">
        <bpmn:incoming>Flow_0uhi1kx</bpmn:incoming>
        <bpmn:outgoing>Flow_0lp8bi5</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0tklm91" messageRef="Message_09b6d8c" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_0uhi1kx" sourceRef="Gateway_0timu5e" targetRef="Event_07j6aif" />
      <bpmn:endEvent id="Event_1o3pjjb" name="Änderungen gewünscht">
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.setVariable(&#34;funeralAccepted&#34;, false)}" event="start" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1jkx75d</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1jkx75d" sourceRef="Event_19c9atk" targetRef="Event_1o3pjjb" />
      <bpmn:endEvent id="Event_1jnl29z" name="Entscheidung bestätigt">
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.setVariable(&#34;funeralAccepted&#34;, true)}" event="start" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0lp8bi5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0lp8bi5" sourceRef="Event_07j6aif" targetRef="Event_1jnl29z" />
