    <bpmn:sequenceFlow id="Flow_0tqufez" sourceRef="StartEvent_Trauerfall" targetRef="Gateway_0eoijma" />
    <bpmn:sequenceFlow id="Flow_0n20skx" sourceRef="Gateway_0eoijma" targetRef="Activity_0dcyj4j" />
