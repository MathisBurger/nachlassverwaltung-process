    <bpmn:receiveTask id="Activity_1ciygxm" name="Bestattungspräferenzen empfangen" messageRef="Message_1vjje9l">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">const funeralPreference = S(JSON.stringify({funeralType, funeralObject, maxAmountGuests, budget}), "application/json");

execution.setVariable("funeralPreference", funeralPreference);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cgx0e2</bpmn:incoming>
      <bpmn:outgoing>Flow_1tdnw2y</bpmn:outgoing>
    </bpmn:receiveTask>
