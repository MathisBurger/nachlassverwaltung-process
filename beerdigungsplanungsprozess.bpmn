  <bpmn:process id="funeralPlanningProcess" name="Beerdigungsplanungsprozess" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_Trauerfall" name="Beerdigung soll geplant werden">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_0tqufez</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1qmwy1u" sourceRef="Activity_0mtezji" targetRef="Activity_Feier" />
