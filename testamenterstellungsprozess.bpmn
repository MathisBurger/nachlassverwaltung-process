      <bpmn:startEvent id="Event_156q75p">
        <bpmn:extensionElements>
          <camunda:executionListener event="end">
            <camunda:script scriptFormat="JavaScript">function flattenOwnership(data) {
  return Object.entries(data).flatMap(([object, owners]) =&gt;
    Object.entries(owners).map(([owner, percentage]) =&gt; ({
      object,
      owner,
      percentage,
    }))
  );
}

const estateSplitJson = JSON.parse(estateSplit.toString());
const normalizedEstateSplit = flattenOwnership(estateSplitJson);
execution.setVariableLocal("normalizedEstateSplit", S(JSON.stringify(normalizedEstateSplit)));</camunda:script>
          </camunda:executionListener>
