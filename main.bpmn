    <bpmn:startEvent id="Event_1qte4uv" name="Registrierungsinformationen erhalten">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">execution.setVariable("registrationInformation", S(JSON.stringify({username, password, email, birthday})));</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0tiungv</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1lr6lcd" messageRef="Message_0krdok8" />
    </bpmn:startEvent>
    <bpmn:callActivity id="Activity_09l5ttw" name="Registrierung" calledElement="registrationProcess">
      <bpmn:extensionElements>
        <camunda:in source="registrationInformation" target="registrationInformation" />
