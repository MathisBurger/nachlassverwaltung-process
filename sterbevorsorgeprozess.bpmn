    <bpmn:startEvent id="Event_1qte4uv" name="Registrierungsinformationen erhalten">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">execution.setVariable("initialRegistrationInformation", S(JSON.stringify({username, password, email, birthday, idCardNumber})));</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0tiungv</bpmn:outgoing>
