  <inputData id="funeralType" name="Bestattungsart" />
  <inputData id="budget" name="Budget" />
  <inputData id="maxAmountGuests" name="Anzahl der Trauergäste" />
  <decision id="determineServiceLevel" name="Service-Level bestimmen" camunda:historyTimeToLive="180">
    <informationRequirement id="InformationRequirement_0001">
      <requiredInput href="#budget" />
    </informationRequirement>
    <decisionTable id="DecisionTable_ServiceLevel">
      <input id="InputClause_0002" label="Budget" camunda:inputVariable="budget">
        <inputExpression id="InputExpression_0003" typeRef="integer">
          <text>budget</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0004" label="Servicepaket" name="serviceLevel" typeRef="string" />
      <rule id="DecisionRule_0005">
        <inputEntry id="UnaryTests_0006">
          <text>&lt; 2500</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0007">
          <text>"basic"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0008">
        <inputEntry id="UnaryTests_0009">
          <text>[2500..5000[</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0010">
          <text>"standard"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0011">
        <inputEntry id="UnaryTests_0012">
          <text>[5000..8000[</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0013">
          <text>"comfort"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0014">
        <inputEntry id="UnaryTests_0015">
          <text>&gt;= 8000</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0016">
          <text>"premium"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="planCeremony" name="Trauerfeier planen" camunda:historyTimeToLive="180">
    <informationRequirement id="InformationRequirement_0017">
      <requiredInput href="#maxAmountGuests" />
    </informationRequirement>
    <decisionTable id="DecisionTable_Ceremony">
      <input id="InputClause_0018" label="Anzahl der Trauergäste" camunda:inputVariable="maxAmountGuests">
        <inputExpression id="InputExpression_0019" typeRef="integer">
          <text>maxAmountGuests</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0020" label="Art der Trauerfeier" name="ceremonyType" typeRef="string" />
      <rule id="DecisionRule_0024">
        <inputEntry id="UnaryTests_0025">
          <text>0</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0026">
          <text>"silent"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0030">
        <inputEntry id="UnaryTests_0031">
          <text>[1..15]</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0032">
          <text>"small"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0036">
        <inputEntry id="UnaryTests_0037">
          <text>]15..50]</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0038">
          <text>"medium"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0042">
        <inputEntry id="UnaryTests_0043">
          <text>]50..120]</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0044">
          <text>"large"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0048">
        <inputEntry id="UnaryTests_0049">
          <text>&gt; 120</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0050">
          <text>"manualCheck"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
