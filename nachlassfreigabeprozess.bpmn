          <bpmn:outgoing>Flow_1tm158h</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_1tm158h" sourceRef="Event_0yhzzx5" targetRef="Activity_0boznz0" />
        <bpmn:scriptTask id="Activity_0boznz0" name="Termineinladung generieren" scriptFormat="JavaScript">
          <bpmn:incoming>Flow_1tm158h</bpmn:incoming>
          <bpmn:outgoing>Flow_0gsqhg1</bpmn:outgoing>
          <bpmn:script>const invitation = `${heir.prop("firstName").stringValue()} ${heir.prop("lastName").stringValue()}, sie sind eingeladen am ${decidedNotaryAppointment} mit der Dauer ${durationInMinutes}.`;
execution.setVariableLocal("invitation", invitation);</bpmn:script>
        </bpmn:scriptTask>
        <bpmn:sendTask id="Activity_18rjyjj" name="Termineinladung versenden" camunda:expression="${1}">
          <bpmn:extensionElements>
            <camunda:executionListener event="start">
              <camunda:script scriptFormat="JavaScript">print("Sending invitation (" + invitation + ") to " + heir.prop("email").stringValue())</camunda:script>
            </camunda:executionListener>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_0gsqhg1</bpmn:incoming>
          <bpmn:outgoing>Flow_1qno5jl</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:sequenceFlow id="Flow_0gsqhg1" sourceRef="Activity_0boznz0" targetRef="Activity_18rjyjj" />
        <bpmn:endEvent id="Event_0r7qwsn">
          <bpmn:incoming>Flow_1qno5jl</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1qno5jl" sourceRef="Activity_18rjyjj" targetRef="Event_0r7qwsn" />
