      <bpmn:outgoing>Flow_1y5ngna</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_02q50oa" name="Bis nach der Testamentlesung gewartet">
      <bpmn:incoming>Flow_1elgdt2</bpmn:incoming>
      <bpmn:outgoing>Flow_0c6tn7a</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1xpuc9c">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${decidedNotaryAppointment}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Activity_0qa1g79" name="Gesetzliche Erbfolge befolgen">
      <bpmn:incoming>Flow_0vmis6z</bpmn:incoming>
      <bpmn:outgoing>Flow_1ra71xm</bpmn:outgoing>
      <bpmn:sendTask id="Activity_1in3i3g" name="Erbscheinantrag stellen lassen" camunda:expression="${1}">
        <bpmn:extensionElements>
          <camunda:executionListener event="start">
            <camunda:script scriptFormat="JavaScript">print("Requesting grantOfProbate for " + execution.getProcessBusinessKey() + " from notary")</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0dblha9</bpmn:incoming>
        <bpmn:outgoing>Flow_0vgcrzq</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="Activity_1fjrvom" name="Erbschein erhalten" messageRef="Message_3eag7q8">
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.setVariable(&#34;heirsList&#34;, grantOfProbate)}" event="end" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0vgcrzq</bpmn:incoming>
        <bpmn:outgoing>Flow_044m50u</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:scriptTask id="Activity_17a94yb" name="Gesetzliche Erbquoten berechnen" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_044m50u</bpmn:incoming>
        <bpmn:outgoing>Flow_1nlncaq</bpmn:outgoing>
        <bpmn:script>const grantOfProbateRaw = JSON.parse(grantOfProbate.toString());

let splitInfo = '';

for (const element of grantOfProbateRaw) {
splitInfo += `An ${element.email} gehen ${100 / grantOfProbateRaw.length}%\n`;
}

execution.setVariable("splitInfo", splitInfo);</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_0vgcrzq" sourceRef="Activity_1in3i3g" targetRef="Activity_1fjrvom" />
      <bpmn:sequenceFlow id="Flow_044m50u" sourceRef="Activity_1fjrvom" targetRef="Activity_17a94yb" />
      <bpmn:startEvent id="Event_08a2mer" name="Testament wurde abgelehnt">
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.setVariableLocal(&#34;grantOfProbate&#34;, S(&#34;[]&#34;))}" event="end" />
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_0dblha9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0dblha9" sourceRef="Event_08a2mer" targetRef="Activity_1in3i3g" />
      <bpmn:sequenceFlow id="Flow_1nlncaq" sourceRef="Activity_17a94yb" targetRef="Event_01l6tdp" />
      <bpmn:endEvent id="Event_01l6tdp">
        <bpmn:incoming>Flow_1nlncaq</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="TextAnnotation_0nu1gue">
