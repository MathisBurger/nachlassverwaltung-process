          <bpmn:incoming>Flow_10782qg</bpmn:incoming>
          <bpmn:outgoing>Flow_0xdqqzh</bpmn:outgoing>
        </bpmn:receiveTask>
        <bpmn:sequenceFlow id="Flow_0xdqqzh" sourceRef="Activity_0im01cr" targetRef="Activity_102tof6" />
        <bpmn:scriptTask id="Activity_102tof6" name="Abstimmung im System registrieren" scriptFormat="JavaScript">
          <bpmn:incoming>Flow_0xdqqzh</bpmn:incoming>
          <bpmn:outgoing>Flow_07nd54l</bpmn:outgoing>
          <bpmn:script>const votes = JSON.parse(appointmentVotes.toString());

if (votes[vote] === undefined) {
votes[vote] = 1;
} else {
votes[vote] += 1;
}

execution.setVariable("appointmentVotes", S(JSON.stringify(votes)));</bpmn:script>
        </bpmn:scriptTask>
        <bpmn:endEvent id="Event_0exfywb">
          <bpmn:incoming>Flow_07nd54l</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_07nd54l" sourceRef="Activity_102tof6" targetRef="Event_0exfywb" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_1d6sgwk" sourceRef="Activity_0ij6uo8" targetRef="Activity_10tn0v8" />
      <bpmn:subProcess id="Activity_10tn0v8">
        <bpmn:incoming>Flow_1d6sgwk</bpmn:incoming>
        <bpmn:outgoing>Flow_1v5kpu5</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics camunda:collection="${heirsList.elements()}" camunda:elementVariable="heir" />
        <bpmn:startEvent id="Event_0yhzzx5">
          <bpmn:extensionElements>
            <camunda:executionListener expression="${execution.setVariableLocal(&#34;email&#34;, heir.prop(&#34;email&#34;).stringValue())}" event="start" />
