      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1v5kpu5" sourceRef="Activity_10tn0v8" targetRef="Event_0jccamu" />
      <bpmn:sequenceFlow id="Flow_0r2l95i" sourceRef="Activity_1bvjat3" targetRef="Activity_12mkd25" />
      <bpmn:sequenceFlow id="Flow_1lz98gf" sourceRef="Activity_12mkd25" targetRef="Activity_0ij6uo8" />
      <bpmn:scriptTask id="Activity_12mkd25" name="Notartermineintrag generieren" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_0r2l95i</bpmn:incoming>
        <bpmn:outgoing>Flow_1lz98gf</bpmn:outgoing>
        <bpmn:script>const votes = JSON.parse(appointmentVotes.toString());

const largestKey = Object.keys(votes).reduce((a, b) =&gt; data[a] &gt; data[b] ? a : b);

execution.setVariable("decidedNotaryAppointment", largestKey);</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:businessRuleTask id="Activity_1afwnlg" name="Termindauer bestimmen" camunda:resultVariable="durationInMinutes" camunda:decisionRef="durationNotarySession" camunda:mapDecisionResult="singleEntry">
        <bpmn:extensionElements />
        <bpmn:incoming>Flow_1y9vrnt</bpmn:incoming>
        <bpmn:outgoing>Flow_0hm39s8</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:sequenceFlow id="Flow_1y9vrnt" sourceRef="Event_020g0c9" targetRef="Activity_1afwnlg" />
      <bpmn:sequenceFlow id="Flow_0hm39s8" sourceRef="Activity_1afwnlg" targetRef="Activity_05e6q8f" />
