        <bpmn:startEvent id="Event_0x0tflq">
          <bpmn:extensionElements>
            <camunda:executionListener expression="${execution.setVariableLocal(&#34;vote&#34;, &#34;&#34;)}" event="start" />
            <camunda:executionListener expression="${execution.setVariableLocal(&#34;email&#34;, heir.prop(&#34;email&#34;).stringValue())}" event="start" />
          </bpmn:extensionElements>
          <bpmn:outgoing>Flow_10782qg</bpmn:outgoing>
