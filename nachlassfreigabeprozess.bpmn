    <bpmn:subProcess id="Activity_0g2npn5" name="Terminabstimmung">
      <bpmn:incoming>Flow_06vfzb2</bpmn:incoming>
      <bpmn:outgoing>Flow_1elgdt2</bpmn:outgoing>
      <bpmn:startEvent id="Event_020g0c9" name="Terminabstimmung muss erfolgen">
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.setVariableLocal(&#34;durationInMinutes&#34;, 0)}" event="end" />
