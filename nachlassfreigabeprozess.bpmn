      <bpmn:sendTask id="Activity_0gdd4rn" name="Terminvorschläge versenden" camunda:expression="${1}">
        <bpmn:extensionElements>
          <camunda:executionListener event="start">
            <camunda:script scriptFormat="JavaScript">print("Sending appointmentOffers " + appointmentOffers.toString() + " to " + heir.prop("email").stringValue())</camunda:script>
          </camunda:executionListener>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_17xg5wl</bpmn:incoming>
        <bpmn:outgoing>Flow_0c7rtf2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics camunda:collection="${heirsList.elements()}" camunda:elementVariable="heir" />
      </bpmn:sendTask>
